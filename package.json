{
  "name": "dsh-word-writing-spec",
  "version": "0.2.0",
  "description": "Word 写作规范插件：把《AI辅助开发文档格式规范指南》变成可执行的生成约束、审查/修复工具，以及可在设置面板调参的规则表。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VisualStudioXu/dsh-word-writing-spec.git"
  },
  "homepage": "https://github.com/VisualStudioXu/dsh-word-writing-spec#readme",
  "bugs": {
    "url": "https://github.com/VisualStudioXu/dsh-word-writing-spec/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./rules/*.json": "./rules/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "rules",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "word",
    "docx",
    "writing-spec",
    "format-audit"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
